<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAotCandidate>false</IsAotCandidate>
    <IsPackable>false</IsPackable>
    <Description>Kun Framework sample: Catalog service demonstrating DDD + CQRS + Outbox over EF Core + PostgreSQL.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kun.Sample.Shared\Kun.Sample.Shared.csproj" />
    <ProjectReference Include="..\..\src\Kun.Core\Kun.Core.csproj" />
    <ProjectReference Include="..\..\src\Kun.Mediator\Kun.Mediator.csproj" />
    <ProjectReference Include="..\..\src\Kun.Validation\Kun.Validation.csproj" />
    <ProjectReference Include="..\..\src\Kun.EventBus\Kun.EventBus.csproj" />
    <ProjectReference Include="..\..\src\Kun.EntityFrameworkCore\Kun.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Kun.Dapper\Kun.Dapper.csproj" />
    <ProjectReference Include="..\..\src\Kun.AspNetCore\Kun.AspNetCore.csproj" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="All" />
    <ProjectReference Include="..\..\src\Kun.Grpc\Kun.Grpc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\catalog.proto" GrpcServices="Server" />
  </ItemGroup>
</Project>
