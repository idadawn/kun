<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <!-- Opt into AOT for this sample so it doubles as an AOT smoke-test for Kun.Mediator. -->
    <IsAotCandidate>true</IsAotCandidate>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>Minimal AOT-publishable console sample wiring KunMediator with Logging / Performance / Tracing behaviors. Used as the 0.1.0-alpha.1 AOT canary.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kun.Core\Kun.Core.csproj" />
    <ProjectReference Include="..\..\src\Kun.Mediator\Kun.Mediator.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
