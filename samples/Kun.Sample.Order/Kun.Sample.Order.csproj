<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAotCandidate>false</IsAotCandidate>
    <IsPackable>false</IsPackable>
    <Description>Kun Framework sample: Order service demonstrating Saga orchestration with compensation + timeout paths.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kun.Sample.Shared\Kun.Sample.Shared.csproj" />
    <ProjectReference Include="..\..\src\Kun.Core\Kun.Core.csproj" />
    <ProjectReference Include="..\..\src\Kun.Mediator\Kun.Mediator.csproj" />
    <ProjectReference Include="..\..\src\Kun.Validation\Kun.Validation.csproj" />
    <ProjectReference Include="..\..\src\Kun.EventBus\Kun.EventBus.csproj" />
    <ProjectReference Include="..\..\src\Kun.EntityFrameworkCore\Kun.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Kun.AspNetCore\Kun.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Kun.Saga\Kun.Saga.csproj" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="All" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\Kun.Sample.Catalog\Protos\catalog.proto" GrpcServices="Client">
      <Link>Protos\catalog.proto</Link>
    </Protobuf>
  </ItemGroup>
</Project>
