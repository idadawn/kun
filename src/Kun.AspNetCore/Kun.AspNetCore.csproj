<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCandidate>true</IsAotCandidate>
    <HasPublicApi>true</HasPublicApi>
    <IsPackable>true</IsPackable>
    <Description>Kun Framework — ASP.NET Core integration: Minimal API extensions, ProblemDetails, global exception handler.</Description>
    <!-- RS0036: ProblemDetails in ASP.NET Core is not nullable-annotated; suppress missing annotation warning -->
    <NoWarn>$(NoWarn);RS0036</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kun.Core\Kun.Core.csproj" />
    <ProjectReference Include="..\Kun.Mediator\Kun.Mediator.csproj" />
    <ProjectReference Include="..\Kun.Validation\Kun.Validation.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
