{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "KunGateway": {
    "ExternalIssuer": "https://login.example.com",
    "ExternalAudience": "my-api",
    "ExternalJwksUri": "https://login.example.com/.well-known/openid-configuration",
    "InternalIssuer": "kun-gateway",
    "InternalAudience": "kun-internal",
    "InternalTokenLifetimeSeconds": 60,
    "SigningKeyPath": "certs/gateway-private.pem",
    "PublicKeyPath": "certs/gateway-public.pem"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      /*
       * gRPC-Web route example:
       * Browser clients send grpc-web (Content-Type: application/grpc-web+proto) over HTTP/1.1.
       * UseGrpcWeb() middleware (DefaultEnabled=true) transparently upgrades the request to
       * standard gRPC before YARP forwards it. The backend cluster must use HTTP/2.
       * No additional per-route config is required on the YARP side.
       */
      "catalog-grpc-route": {
        "ClusterId": "catalog-grpc-cluster",
        "Match": {
          "Path": "/grpc/catalog/{**catch-all}",
          "Methods": [ "POST" ]
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog-1": {
            "Address": "http://catalog-service:8080"
          }
        }
      },
      "catalog-grpc-cluster": {
        "HttpRequest": {
          "Version": "2",
          "VersionPolicy": "RequestVersionOrHigher"
        },
        "Destinations": {
          "catalog-grpc-1": {
            "Address": "http://catalog-service:8090"
          }
        }
      }
    }
  }
}
