<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      IsAotCandidate=false: Kun.Saga currently bundles EF persistence
      (Persistence/Ef/*.cs) in the same assembly, which transitively
      exposes Kun.EntityFrameworkCore's IL2091 / IL2060 / IL2026 /
      IL3050 through ILC. See docs/architecture/AOT-audit-2026-04-23.md.
      Tracked follow-up: P2-KN-Saga-EF-Split extracts a dedicated
      Kun.Saga.EntityFrameworkCore to restore AOT-candidate status.
    -->
    <IsAotCandidate>false</IsAotCandidate>
    <IsPackable>true</IsPackable>
    <HasPublicApi>true</HasPublicApi>
    <Description>Saga Orchestration engine for Kun Framework: steps, compensation, timeouts, state persistence.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kun.Core\Kun.Core.csproj" />
    <ProjectReference Include="..\Kun.EventBus\Kun.EventBus.csproj" />
    <ProjectReference Include="..\Kun.Mediator\Kun.Mediator.csproj" />
    <ProjectReference Include="..\Kun.EntityFrameworkCore\Kun.EntityFrameworkCore.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
